{
  "name": "umsa-transporte-electron",
  "version": "1.0.0",
  "main": "electron/main.js",
  "private": true,
  "description": "Electron wrapper para UMSA Transporte (frontend Angular + backend Node)",
  "scripts": {
    "electron:dev": "concurrently \"cd backend && npm start\" \"cd frontend && npm start\" \"wait-on http://localhost:4200 && ELECTRON_DEV=true electron .\"",
    "electron:serve": "ELECTRON_DEV=true electron .",
    "electron:build-frontend": "cd frontend && npm run build",
    "electron:prod": "npm run electron:build-frontend && electron .",
    "dist:win": "cd backend && npm install && cd .. && npm run electron:build-frontend && node -e \"const fs=require('fs'); const path=require('path'); if(!fs.existsSync('frontend/dist/frontend/index.html')){console.error('ERROR: Frontend no construido. Ejecuta: npm run electron:build-frontend'); process.exit(1);}\" && electron-builder --win nsis",
    "dist:all": "npm run electron:build-frontend && electron-builder -mwl"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "electron": "^26.0.0",
    "wait-on": "^7.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.umsa.transporte",
    "productName": "UMSA Transporte",
    "asar": false,
    "files": [
      "electron/**/*",
      "backend/**/*",
      "!backend/node_modules/**/*",
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*", "!**/*.map"]
      },
      "!frontend/src/**/*",
      "!**/*.log",
      "!**/.git/**/*",
      "!backend/test-qr.js",
      "!backend/generate-jwt-secret.js",
      "!backend/regenerar-qrs.sh"
    ],
    "extraResources": [
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UMSA Transporte"
    }
  }
}

